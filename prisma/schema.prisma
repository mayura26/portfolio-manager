// Portfolio Manager database schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Settings (single-user, one row)
// ─────────────────────────────────────────────────────────────

model Settings {
  id                        String   @id @default("singleton")
  defaultBaseCurrency       String   @default("USD")
  pushEnabled               Boolean  @default(false)
  pushSubscription          Json?
  watchlistAiModel          String   @default("gpt-5.4")
  watchlistAiReasoning      String   @default("medium")
  sellSignalGainPercent     Decimal  @default(25) @db.Decimal(8, 4)
  pinUserForecastsByDefault Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Portfolio
// ─────────────────────────────────────────────────────────────

model Portfolio {
  id           String   @id @default(cuid())
  groupId      String
  name         String
  description  String?
  baseCurrency String   @default("USD")

  // Target weight of this portfolio inside its group (0-100). Group cash takes the remainder.
  targetPercentInGroup    Decimal @default(0) @db.Decimal(8, 4)
  targetMinPercentInGroup Decimal @default(0) @db.Decimal(8, 4)
  targetMaxPercentInGroup Decimal @default(0) @db.Decimal(8, 4)

  // AI composition analysis (latest snapshot, JSON shape produced by lib/composition-ai.ts).
  aiCompositionAnalysis    Json?
  aiCompositionGeneratedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group          PortfolioGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  trades         Trade[]
  alerts         Alert[]
  reviews        Review[]
  targets        PortfolioTarget[]
  watchlistItems WatchlistItem[]

  @@index([createdAt])
  @@index([groupId])
}

// ─────────────────────────────────────────────────────────────
// Instrument (stock / ETF / etc.)
// ─────────────────────────────────────────────────────────────

model Instrument {
  id             String   @id @default(cuid())
  symbol         String
  exchange       String
  yahooSymbol    String   @unique
  name           String
  currency       String
  sector         String?
  industry       String?
  instrumentType String   @default("EQUITY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // AutoWatcher — daily AI news monitoring + P&L milestone alerts
  autoWatcherEnabled     Boolean   @default(false)
  autoWatcherThreshold   Decimal   @default(10) @db.Decimal(8, 4)
  autoWatcherLastBand    Int?
  autoWatcherLastDailyAt DateTime?

  trades         Trade[]
  prices         PriceHistory[]
  alerts         Alert[]
  reviews        Review[]
  notes          StockNote[]
  watchlistItems WatchlistItem[]
  forecasts      InstrumentForecast[]
  targets        PortfolioTarget[]
  congressTrades CongressTrade[]

  @@index([symbol, exchange])
  @@index([yahooSymbol])
}

// ─────────────────────────────────────────────────────────────
// Trade
// ─────────────────────────────────────────────────────────────

enum TradeType {
  BUY
  SELL
}

model Trade {
  id           String    @id @default(cuid())
  portfolioId  String
  instrumentId String
  type         TradeType
  quantity     Decimal   @db.Decimal(18, 8)
  price        Decimal   @db.Decimal(18, 8)
  currency     String
  fxRate       Decimal?  @db.Decimal(18, 8)
  fees         Decimal   @default(0) @db.Decimal(18, 4)
  date         DateTime
  notes        String?
  isHidden     Boolean   @default(false)
  hiddenAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  externalRef  String?

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([portfolioId, externalRef])
  @@index([portfolioId, date])
  @@index([instrumentId, date])
  @@index([portfolioId, instrumentId])
}

// ─────────────────────────────────────────────────────────────
// Price History (EOD)
// ─────────────────────────────────────────────────────────────

model PriceHistory {
  id           String   @id @default(cuid())
  instrumentId String
  date         DateTime @db.Date
  open         Decimal  @db.Decimal(18, 4)
  high         Decimal  @db.Decimal(18, 4)
  low          Decimal  @db.Decimal(18, 4)
  close        Decimal  @db.Decimal(18, 4)
  volume       BigInt?

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, date])
  @@index([instrumentId, date(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// FX Rate (daily exchange rates)
// ─────────────────────────────────────────────────────────────

model FxRate {
  id   String   @id @default(cuid())
  pair String
  date DateTime @db.Date
  rate Decimal  @db.Decimal(18, 8)

  @@unique([pair, date])
  @@index([pair, date(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PCT_CHANGE
  REVIEW_TIMER
  ALLOCATION_DRIFT
  DIVIDEND_EVENT
  EARNINGS_EVENT
  FORECAST_DEVIATION
  TARGET_HIT
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  SNOOZED
  DISMISSED
}

model Alert {
  id           String      @id @default(cuid())
  type         AlertType
  status       AlertStatus @default(ACTIVE)
  portfolioId  String?
  instrumentId String?

  // Price alert fields
  priceTarget    Decimal? @db.Decimal(18, 4)
  priceDirection String?
  pctChange      Decimal? @db.Decimal(8, 4)
  referencePrice Decimal? @db.Decimal(18, 4)

  // Time-based review fields
  reviewIntervalDays Int?
  lastReviewDate     DateTime?

  // Allocation drift fields
  allocationThreshold Decimal? @db.Decimal(8, 4)

  // Forecast-deviation fields
  forecastId         String?
  deviationThreshold Decimal? @db.Decimal(8, 4)

  // Plan-level linkage: when set, this alert was auto-created from a
  // PortfolioTarget buy/sell level and is kept in sync with it.
  portfolioTargetId String?

  // Snooze fields
  snoozedUntil DateTime?

  message     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  triggeredAt DateTime?

  portfolio       Portfolio?          @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument      Instrument?         @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  forecast        InstrumentForecast? @relation(fields: [forecastId], references: [id], onDelete: SetNull)
  portfolioTarget PortfolioTarget?    @relation(fields: [portfolioTargetId], references: [id], onDelete: Cascade)
  reviews         Review[]
  notifications   Notification[]
  watchlistItem   WatchlistItem?

  @@index([status, type])
  @@index([instrumentId, status])
  @@index([portfolioId, status])
  @@index([forecastId])
  @@index([portfolioTargetId])
}

// ─────────────────────────────────────────────────────────────
// Review (task queue)
// ─────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ReviewAction {
  HOLD
  BUY
  SELL
  WATCH
  OTHER
}

model Review {
  id            String        @id @default(cuid())
  status        ReviewStatus  @default(PENDING)
  alertId       String?
  portfolioId   String?
  instrumentId  String?
  triggerReason String
  notes         String?
  action        ReviewAction?
  priority      Int           @default(0)
  decisionDate  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  alert      Alert?      @relation(fields: [alertId], references: [id], onDelete: SetNull)
  portfolio  Portfolio?  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([status, priority(sort: Desc)])
  @@index([instrumentId, status])
  @@index([portfolioId, status])
}

// ─────────────────────────────────────────────────────────────
// Stock Notes (per-instrument user notes)
// ─────────────────────────────────────────────────────────────

model StockNote {
  id           String   @id @default(cuid())
  instrumentId String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId, updatedAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  PRICE_ALERT
  REVIEW_DUE
  ALLOCATION_DRIFT
  DIVIDEND_EVENT
  EARNINGS_EVENT
  FORECAST_DEVIATION
  AUTO_WATCHER
  SYSTEM
  ACHIEVEMENT
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  dismissed Boolean          @default(false)
  alertId   String?
  metadata  Json?
  createdAt DateTime         @default(now())

  alert Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([read, dismissed, createdAt(sort: Desc)])
  @@index([alertId])
}

// ─────────────────────────────────────────────────────────────
// Watchlist
// ─────────────────────────────────────────────────────────────

enum WatchlistStatus {
  WATCHING
  ARCHIVED
  BOUGHT
}

model WatchlistItem {
  id           String          @id @default(cuid())
  instrumentId String
  portfolioId  String?
  status       WatchlistStatus @default(WATCHING)

  buyRangeLow  Decimal? @db.Decimal(18, 4)
  buyRangeHigh Decimal? @db.Decimal(18, 4)
  aiAnalysis   Json?
  alertId      String?  @unique
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  portfolio  Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  alert      Alert?     @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@unique([instrumentId])
  @@index([status, createdAt(sort: Desc)])
  @@index([portfolioId])
}

// ─────────────────────────────────────────────────────────────
// Portfolio Group (top-level bucket: cash + portfolios)
// ─────────────────────────────────────────────────────────────

model PortfolioGroup {
  id           String   @id @default(cuid())
  name         String
  description  String?
  baseCurrency String   @default("USD")

  // Target weight reserved for cash (0-100). Plus the target weights of all
  // portfolios in this group must equal 100. Min/max fields define the allowed
  // band; the single target remains a midpoint/reference for compatibility.
  cashTargetPercent    Decimal @default(0) @db.Decimal(8, 4)
  cashTargetMinPercent Decimal @default(0) @db.Decimal(8, 4)
  cashTargetMaxPercent Decimal @default(0) @db.Decimal(8, 4)

  investmentObjective     String?
  riskTolerance           String?
  timeHorizon             String?
  liquidityNeed           String?
  investmentProfileNotes  String?

  ibkrFlexToken   String?
  ibkrFlexQueryId String?

  aiCompositionAnalysis    Json?
  aiCompositionGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios       Portfolio[]
  cashTransactions CashTransaction[]
  cashStatementImports CashStatementImport[]
  ibkrSyncRuns     IbkrSyncRun[]

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// IBKR Flex sync runs (one row per cron / manual sync per group)
// ─────────────────────────────────────────────────────────────

model IbkrSyncRun {
  id            String         @id @default(cuid())
  groupId       String
  group         PortfolioGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  ok            Boolean        @default(false)

  inserted      Int            @default(0)
  skipped       Int            @default(0)
  cashInserted  Int            @default(0)
  cashSkipped   Int            @default(0)

  // Array of { symbol, reason } objects for symbols that could not be resolved.
  failedSymbols Json           @default("[]")

  // Top-level failure (Flex unreachable, bad token, parse error, etc.).
  // Null when the run completed even if individual symbols failed.
  error         String?

  // "cron" | "manual"
  trigger       String         @default("cron")

  @@index([groupId, startedAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Price refresh runs (global Yahoo Finance EOD pulls — cron or manual)
// ─────────────────────────────────────────────────────────────

model PriceRefreshRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  ok          Boolean   @default(false)

  // Instruments attempted in this run.
  instruments Int       @default(0)
  // PriceHistory rows newly inserted (skipDuplicates count).
  bars        Int       @default(0)

  // Array of { yahooSymbol, error } objects for instruments that threw.
  failures    Json      @default("[]")

  // Top-level fatal error (DB connection, etc.). Null even if some symbols failed.
  error       String?

  // "cron" | "manual"
  trigger     String    @default("cron")

  @@index([startedAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Cron job runs (one row per scheduled command invocation)
// ─────────────────────────────────────────────────────────────

model CronJobRun {
  id         String    @id @default(cuid())
  job        String
  command    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  warnings   Int       @default(0)
  summary    Json?
  error      String?

  @@index([job, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Cash Transactions (group-level deposits / withdrawals / seedings)
// ─────────────────────────────────────────────────────────────

enum CashTransactionType {
  SEED
  DEPOSIT
  WITHDRAWAL
  DIVIDEND
  INTEREST
  FEE
  WITHHOLDING
  FX_IN
  FX_OUT
}

enum CashTransactionSource {
  MANUAL
  IBKR
  EXTERNAL_STATEMENT
}

model CashStatementImport {
  id             String   @id @default(cuid())
  groupId        String
  provider       String
  accountLast4   String
  sourceAccountKey String
  accountType    String?
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  statementGeneratedAt DateTime?
  currency       String
  endingBalance  Decimal  @db.Decimal(18, 4)
  filename       String
  fileHash       String
  importInserted Int      @default(0)
  importSkipped  Int      @default(0)
  reconciliationDelta Decimal @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  group PortfolioGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cashTransactions CashTransaction[]

  @@unique([groupId, fileHash])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([groupId, sourceAccountKey, periodEnd])
}

model CashTransaction {
  id        String              @id @default(cuid())
  groupId   String
  type      CashTransactionType
  amount    Decimal             @db.Decimal(18, 4)
  currency  String
  fxRate    Decimal?            @db.Decimal(18, 8)
  date      DateTime
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  externalRef String?
  source      CashTransactionSource @default(MANUAL)
  sourceAccountKey String?
  statementImportId String?

  group PortfolioGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  statementImport CashStatementImport? @relation(fields: [statementImportId], references: [id], onDelete: SetNull)

  @@unique([groupId, externalRef])
  @@index([groupId, date])
  @@index([groupId, source, sourceAccountKey, date])
  @@index([statementImportId])
}

// ─────────────────────────────────────────────────────────────
// Portfolio Targets (per-instrument target weight inside a portfolio).
// Source of truth for "I want N% of this portfolio in this stock" — works
// for owned and not-yet-owned instruments alike.
// ─────────────────────────────────────────────────────────────

enum PortfolioRecommendationAction {
  BUY
  SELL
  TRIM
}

enum PortfolioRecommendationSource {
  MANUAL
  AI
}

model PortfolioTarget {
  id                 String   @id @default(cuid())
  portfolioId        String
  instrumentId       String
  targetPercent      Decimal  @db.Decimal(8, 4)
  targetMinPercent   Decimal  @default(0) @db.Decimal(8, 4)
  targetMaxPercent   Decimal  @default(0) @db.Decimal(8, 4)
  intendedBuyPrice   Decimal? @db.Decimal(18, 4)
  intendedSellPrice  Decimal? @db.Decimal(18, 4)
  trimAtGainPercent  Decimal? @db.Decimal(8, 4)
  notes              String?
  recommendationAction          PortfolioRecommendationAction?
  recommendationSource          PortfolioRecommendationSource?
  recommendationRationale       String?
  recommendationGeneratedAt     DateTime?
  recommendationModel           String?
  recommendationReasoningEffort String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  alerts     Alert[]

  @@unique([portfolioId, instrumentId])
  @@index([portfolioId])
}

// ─────────────────────────────────────────────────────────────
// Instrument Forecasts (AI-generated price targets + scenarios).
// One row per generated forecast — history is preserved so reviews can
// see how the thesis has evolved.
// ─────────────────────────────────────────────────────────────

enum ForecastSource {
  AI
  USER
}

model InstrumentForecast {
  id              String         @id @default(cuid())
  instrumentId    String
  source          ForecastSource @default(AI)
  isPinned        Boolean        @default(false)
  documentId      String?
  targetPrice     Decimal        @db.Decimal(18, 4)
  lowCase         Decimal?       @db.Decimal(18, 4)
  highCase        Decimal?       @db.Decimal(18, 4)
  expectedReturn  Decimal?       @db.Decimal(8, 4)
  horizonMonths   Int            @default(12)
  rationale       String
  model           String
  reasoningEffort String

  // Snapshot of Yahoo street consensus at generation time (AI rows only).
  streetTargetMean       Decimal? @db.Decimal(18, 4)
  streetTargetHigh       Decimal? @db.Decimal(18, 4)
  streetTargetLow        Decimal? @db.Decimal(18, 4)
  streetRecommendation   String?
  streetNumberOfAnalysts Int?

  generatedAt DateTime @default(now())

  instrument Instrument                   @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  document   InstrumentForecastDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  alerts     Alert[]

  @@index([instrumentId, generatedAt(sort: Desc)])
  @@index([instrumentId, source, generatedAt(sort: Desc)])
  @@index([instrumentId, isPinned])
}

// ─────────────────────────────────────────────────────────────
// Instrument Forecast Documents
// User-uploaded analysis docs (PDF/MD/TXT). We store extracted text only.
// ─────────────────────────────────────────────────────────────

model InstrumentForecastDocument {
  id             String   @id @default(cuid())
  instrumentId   String
  filename       String
  mimeType       String
  byteSize       Int
  extractedText  String
  createdAt      DateTime @default(now())

  forecasts InstrumentForecast[]

  @@index([instrumentId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Portfolio Review — muted setup-audit checks.
// Each row silences one audit gap, keyed by a stable per-gap identifier.
// ─────────────────────────────────────────────────────────────

model MutedAuditCheck {
  id        String   @id @default(cuid())
  checkKey  String   @unique
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Weekly Report — AI-written Sunday→Saturday review, saved so re-reads
// don't re-generate. One row per week (keyed by its Sunday start date).
// ─────────────────────────────────────────────────────────────

model WeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime @db.Date
  weekEnd     DateTime @db.Date
  content     Json
  model       String
  generatedAt DateTime @default(now())

  @@unique([weekStart])
  @@index([weekStart(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Achievement Records — stores personal-best values so the cron
// job can detect when a new record is set and fire a notification.
// ─────────────────────────────────────────────────────────────

model AchievementRecord {
  id         String   @id @default(cuid())
  key        String   @unique
  value      Decimal  @db.Decimal(18, 4)
  achievedAt DateTime
  metadata   Json?
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Congressional Trades (STOCK Act / House PTR disclosures)
// ─────────────────────────────────────────────────────────────

model CongressTrade {
  id              String    @id @default(cuid())
  politician      String
  stateDist       String?
  chamber         String    @default("House")
  party           String?
  ticker          String
  assetName       String?
  transaction     String
  transactionDate DateTime  @db.Date
  reportDate      DateTime? @db.Date
  rangeRaw        String?
  amountLow       Int?
  amountHigh      Int?
  amountMid       Int?

  instrumentId    String?
  sector          String?
  industry        String?

  externalKey     String    @unique

  createdAt       DateTime  @default(now())

  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  @@index([ticker, transactionDate(sort: Desc)])
  @@index([transactionDate(sort: Desc)])
  @@index([transaction, transactionDate(sort: Desc)])
  @@index([sector, transactionDate(sort: Desc)])
  @@index([instrumentId])
}
